PORT=3000

# Asal frontend yang diizinkan (pisahkan dengan koma). Dev Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=langganku
DB_PASSWORD=langganku
DB_NAME=langganku
# Alternatif satu baris (menimpa DB_HOST dst.): DATABASE_URL=postgres://user:pass@host:5432/db
# DB_SSL=true

# true  = TypeORM membuat/menyesuaikan tabel otomatis (praktis untuk pengembangan)
# false = pakai database/schema.sql dan kelola skema sendiri (disarankan untuk produksi)
DB_SYNC=true

# --- JWT ---
# WAJIB diisi. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

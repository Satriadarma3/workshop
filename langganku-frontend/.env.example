# true  = pakai API tiruan di browser (data tersimpan di localStorage), tanpa backend
# false = pakai backend sungguhan lewat VITE_API_URL
VITE_USE_MOCK=true

# Alamat dasar API. '/api' memakai proxy Vite ke BACKEND_URL saat `npm run dev`.
VITE_API_URL=/api

# Hanya dipakai oleh proxy dev (vite.config.js)
BACKEND_URL=http://localhost:3000
